# Copy to .env.local and fill in from Supabase -> Settings -> API (the same
# project as Bookworm and Giftly). Both values are safe to ship in the client
# bundle: access is controlled by the family link plus the row level security
# policies in supabase/schema.sql.
#
# The Gemini key is NOT here. It lives in the Supabase project's Edge Function
# secrets (GEMINI_API_KEY) and never reaches the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
